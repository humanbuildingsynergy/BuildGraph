bldg:Central_Chiller_1 a brick:Chiller ;
    brick:feeds bldg:Chilled_Water_Pump_1,
        bldg:Chilled_Water_Pump_2 ;
    brick:hasPoint bldg:Central_Chiller_1.Chilled_Water_Differential_Pressure_Sensor,
        bldg:Central_Chiller_1.Chilled_Water_Differential_Pressure_Setpoint,
        bldg:Central_Chiller_1.Chilled_Water_Flow_Sensor,
        bldg:Central_Chiller_1.Chilled_Water_Return_Temperature_Sensor,
        bldg:Central_Chiller_1.Chilled_Water_Return_Temperature_Setpoint,
        bldg:Central_Chiller_1.Chilled_Water_Supply_Temperature_Sensor,
        bldg:Central_Chiller_1.Cooling_Request_Percent_Setpoint,
        bldg:Central_Chiller_1.Enable_Command,
        bldg:Central_Chiller_1.On_Off_Command,
        bldg:Central_Chiller_1.Power_Sensor .

bldg:Central_Chiller_2 a brick:Chiller ;
    brick:feeds bldg:Chilled_Water_Pump_1,
        bldg:Chilled_Water_Pump_2 ;
    brick:hasPoint bldg:Central_Chiller_2.Chilled_Water_Differential_Pressure_Sensor,
        bldg:Central_Chiller_2.Chilled_Water_Return_Temperature_Sensor,
        bldg:Central_Chiller_2.Chilled_Water_Return_Temperature_Setpoint,
        bldg:Central_Chiller_2.Chilled_Water_Supply_Temperature_Sensor,
        bldg:Central_Chiller_2.Chilled_Water_Supply_Temperature_Setpoint,
        bldg:Central_Chiller_2.Enable_Command,
        bldg:Central_Chiller_2.On_Off_Command,
        bldg:Central_Chiller_2.Power_Sensor .

bldg:Cooling_Tower_1 a brick:Cooling_Tower ;
    brick:feeds bldg:Central_Chiller_1,
        bldg:Central_Chiller_2 ;
    brick:hasPoint bldg:Cooling_Tower_1.Enable_Command,
        bldg:Cooling_Tower_1.Entering_Water_Temperature_Sensor,
        bldg:Cooling_Tower_1.On_Off_Command,
        bldg:Cooling_Tower_1.Speed_Setpoint,
