        bldg:CHR-01.Chilled_Water_Flow_Sensor,
        bldg:CHR-01.Chilled_Water_Return_Temperature_Sensor,
        bldg:CHR-01.Chilled_Water_Supply_Temperature_Sensor,
        bldg:CHR-01.Enable_Command,
        bldg:CHR-01.On_Off_Command .

bldg:CHR-02 a brick:Chiller ;
    brick:feeds bldg:CHWP-001,
        bldg:CHWP-002 ;
    brick:hasPoint bldg:CHR-02.Chilled_Water_Differential_Pressure_Sensor,
        bldg:CHR-02.Chilled_Water_Flow_Sensor,
        bldg:CHR-02.Chilled_Water_Supply_Temperature_Sensor,
        bldg:CHR-02.Chilled_Water_Supply_Temperature_Setpoint,
        bldg:CHR-02.Cooling_Request_Percent_Setpoint,
        bldg:CHR-02.Enable_Command,
        bldg:CHR-02.Power_Sensor .

bldg:CT-001 a brick:Cooling_Tower ;
    brick:feeds bldg:CHR-01,
        bldg:CHR-02 ;
    brick:hasPoint bldg:CT-001.Enable_Command,
        bldg:CT-001.Entering_Water_Temperature_Sensor,
        bldg:CT-001.On_Off_Command,
        bldg:CT-001.Speed_Setpoint,
        bldg:CT-001.Supply_Water_Temperature_Sensor,
        bldg:CT-001.Water_Differential_Pressure_Sensor,
        bldg:CT-001.Water_Differential_Temperature_Sensor .

bldg:CT-002 a brick:Cooling_Tower ;
    brick:feeds bldg:CHR-01,
        bldg:CHR-02 ;
    brick:hasPoint bldg:CT-002.Enable_Command,
        bldg:CT-002.Entering_Water_Temperature_Sensor,
        bldg:CT-002.On_Off_Command,
        bldg:CT-002.Speed_Setpoint,
        bldg:CT-002.Supply_Water_Temperature_Sensor,
