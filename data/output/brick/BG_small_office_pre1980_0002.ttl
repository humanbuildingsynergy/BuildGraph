        bldg:Zone_F1_Z03 ;
    brick:hasPart bldg:SupplyFan_AHU01 ;
    brick:hasPoint bldg:AHU01.Outside_Air_Flow_Sensor,
        bldg:AHU01.Return_Air_Flow_Sensor .

