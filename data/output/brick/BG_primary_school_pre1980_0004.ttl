    brick:hasPoint bldg:HVAC_Zone_F1_Z8.Air_Quality_Sensor,
        bldg:HVAC_Zone_F1_Z8.Occupancy_Sensor,
        bldg:HVAC_Zone_F1_Z8.Zone_Air_Heating_Temperature_Setpoint,
        bldg:HVAC_Zone_F1_Z8.Zone_Air_Temperature_Sensor ;
    meta:floorAreaM2 90.5 ;
    meta:spatialLocation "perimeter_S" ;
    meta:zoneType "office" .

bldg:HVAC_Zone_F1_Z9 a brick:HVAC_Zone ;
    rdfs:label "Zone_F1_Z009" ;
    brick:hasPoint bldg:HVAC_Zone_F1_Z9.Occupancy_Sensor,
