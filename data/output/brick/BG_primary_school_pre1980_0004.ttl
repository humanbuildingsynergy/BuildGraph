bldg:Hot_Water_Pump_1 a brick:Hot_Water_Pump ;
    brick:feeds bldg:Air_Handler_01,
        bldg:Air_Handler_02,
        bldg:Air_Handler_03,
        bldg:Air_Handler_04 .

bldg:Supply_Fan_Air_Handler_01 a brick:Supply_Fan ;
    brick:hasPoint bldg:Supply_Fan_Air_Handler_01.Fan_Speed_Setpoint .

bldg:Supply_Fan_Air_Handler_02 a brick:Supply_Fan ;
    brick:hasPoint bldg:Supply_Fan_Air_Handler_02.Fan_Speed_Setpoint,
        bldg:Supply_Fan_Air_Handler_02.Speed_Status,
        bldg:Supply_Fan_Air_Handler_02.Start_Stop_Command .

bldg:Supply_Fan_Air_Handler_03 a brick:Supply_Fan .

