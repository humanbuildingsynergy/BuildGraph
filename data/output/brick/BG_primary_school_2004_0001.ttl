bldg:HWPump01 a brick:Hot_Water_Pump ;
    brick:feeds bldg:AHU01,
        bldg:AHU02,
        bldg:AHU03 .

bldg:HeatingCoil_AHU02 a brick:Heating_Coil ;
    brick:hasPoint bldg:HeatingCoil_AHU02.Hot_Water_Valve_Command .

bldg:HeatingCoil_AHU03 a brick:Heating_Coil ;
    brick:hasPoint bldg:HeatingCoil_AHU03.Hot_Water_Valve_Command .

bldg:EconDamper_AHU01 a brick:Economizer_Damper ;
    brick:hasPoint bldg:EconDamper_AHU01.Damper_Position_Setpoint,
        bldg:EconDamper_AHU01.Outside_Air_Temperature_Sensor .

bldg:HeatingCoil_AHU01 a brick:Heating_Coil ;
    brick:hasPoint bldg:HeatingCoil_AHU01.Discharge_Air_Temperature_Sensor,
        bldg:HeatingCoil_AHU01.Hot_Water_Valve_Command .

bldg:Boiler01 a brick:Boiler ;
    brick:feeds bldg:HWPump01 ;
    brick:hasPoint bldg:Boiler01.Enable_Command,
        bldg:Boiler01.Gas_Sensor,
        bldg:Boiler01.Hot_Water_Flow_Sensor,
        bldg:Boiler01.Hot_Water_Supply_Temperature_Sensor .

