        bldg:Return_Damper_Air_Handler_01,
        bldg:Return_Fan_Air_Handler_01,
        bldg:Supply_Fan_Air_Handler_01 ;
    brick:hasPoint bldg:Air_Handler_01.Mixed_Air_Temperature_Sensor,
        bldg:Air_Handler_01.On_Off_Command,
        bldg:Air_Handler_01.Return_Air_Flow_Sensor,
