bldg:CoolingCoil_AHU03 a brick:Cooling_Coil ;
    brick:hasPoint bldg:CoolingCoil_AHU03.Chilled_Water_Valve_Command .

bldg:HWPump01 a brick:Hot_Water_Pump ;
    brick:feeds bldg:AHU01,
        bldg:AHU02,
        bldg:AHU03,
        bldg:AHU04 .

bldg:CHWPump01 a brick:Chilled_Water_Pump ;
    brick:feeds bldg:AHU01,
        bldg:AHU02,
        bldg:AHU03,
        bldg:AHU04 .

bldg:CHWPump02 a brick:Chilled_Water_Pump ;
    brick:feeds bldg:AHU01,
        bldg:AHU02,
        bldg:AHU03,
        bldg:AHU04 .

bldg:EconDamper_AHU01 a brick:Economizer_Damper ;
    brick:hasPoint bldg:EconDamper_AHU01.Damper_Position_Command,
        bldg:EconDamper_AHU01.Outside_Air_Damper_Command .

bldg:HeatingCoil_AHU02 a brick:Heating_Coil ;
    brick:hasPoint bldg:HeatingCoil_AHU02.Discharge_Air_Temperature_Sensor,
        bldg:HeatingCoil_AHU02.Hot_Water_Valve_Command .

bldg:HeatingCoil_AHU04 a brick:Heating_Coil ;
    brick:hasPoint bldg:HeatingCoil_AHU04.Discharge_Air_Temperature_Sensor,
        bldg:HeatingCoil_AHU04.Hot_Water_Valve_Command .

