        bldg:Chilled_Water_Pump_2 ;
    brick:hasPoint bldg:Central_Chiller_2.Chilled_Water_Return_Temperature_Sensor,
        bldg:Central_Chiller_2.On_Off_Command .

bldg:Cooling_Tower_1 a brick:Cooling_Tower ;
    brick:feeds bldg:Central_Chiller_1,
